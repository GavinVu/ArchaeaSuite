{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchaeaSuite Launcher",
  "mainBinaryName": "ArchaeaSuite",
  "version": "0.1.1",
  "identifier": "org.archaeasuite.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArchaeaSuite",
        "width": 1200,
        "height": 780,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "ArchaeaSuite",
    "copyright": "Copyright (C) 2026 ArchaeaSuite contributors. Licensed under GPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "ArchaeaSuite Launcher",
    "longDescription": "Discover, install, update and launch the free, open-source ArchaeaSuite creative applications.",
    "homepage": "https://github.com/GavinVu/ArchaeaSuite",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRUI3QTQ4RTM1RTE4QkMKUldTOEdGN2pTSHJyLzhTaEM3RkgrK1N6TFJ6b0NpSk40QXBMeW1DeE93eHNYUk5OVDdkTEduVEYK",
      "endpoints": [
        "https://github.com/GavinVu/ArchaeaSuite/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
